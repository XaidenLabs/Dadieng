          "private_key",
          "seed phrase"
        ]
      ],
      "outcome": "BLOCK",
      "reasonCodes": [
        "UNTRUSTED_TOOL_INSTRUCTION",
        "SECRET_ACCESS_REQUEST"
      ]
    },
    {
      "ruleId": "untrusted-instruction-exfiltration",
